# Copy to .env and replace every secret before deployment.
TZ=Asia/Jakarta
APP_HOST_PORT=3010
POSTGRES_HOST_PORT=5433

POSTGRES_DB=utero_dashboard
POSTGRES_USER=utero_app
POSTGRES_PASSWORD=replace-with-long-random-password

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-generated-secret
AUTH_MODE=production
NEXTAUTH_URL=https://dash-monitor.carubra.com

# Development authentication
AUTH_DEMO_ENABLED=false
DEMO_ADMIN_EMAIL=admin@utero.local
DEMO_STAFF_EMAIL=staff@utero.local

# Production Google Workspace authentication
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional integrations
UPLOAD_DIR=.data/evidence
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
APP_VERSION=0.1.0
BUILD_REVISION=local



# Backups are stored on host; mirror encrypted copies off-host.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Monitoring
BACKUP_MAX_AGE_SECONDS=90000
MONITOR_POLL_MS=60000
MONITOR_TIMEOUT_MS=10000
MONITOR_HEARTBEAT_MS=3600000
MONITOR_SERVICE_NAME=utero-dashboard
MONITOR_WEBHOOK_URL=
NOTIFICATION_MAX_STALE_SECONDS=900
